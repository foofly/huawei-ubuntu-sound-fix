[Unit]
Description=Huawei soundcard headphones monitor
After=sound.target
# These are [Unit] directives; systemd silently ignores them under [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@BINDIR@/huawei-soundcard-headphones-monitor.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
